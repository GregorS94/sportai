# Copy to .env and adjust before running `docker compose up -d`

# --- CMS admin login ---
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=change-me-to-something-strong

# --- Session signing key (generate with: openssl rand -hex 32) ---
CMS_SECRET_KEY=replace-with-64-random-hex-chars

# --- CORS origins for the public API ---
# Comma-separated list, or "*" to allow any origin.
CMS_CORS_ORIGINS=https://seelenmut.net,https://www.seelenmut.net
