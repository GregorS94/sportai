---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteName = import.meta.env.PUBLIC_SITE_NAME || "Seelenmut";
const { title, description, image } = Astro.props;
const fullTitle = title ? `${title} — ${siteName}` : siteName;
const desc =
  description ||
  "Seelenmut begleitet Menschen aus der Essstörung – bindungs- und entwicklungsorientierte Innere Arbeit als Lösungsstrategie.";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#faf6ef" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fraunces (variable serif) · Inter (body) · JetBrains Mono (labels) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="grain-layer" aria-hidden="true"></div>
    <!-- soft decorative radials -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(900px_500px_at_85%_-5%,#f2e9d8_0%,transparent_60%),radial-gradient(700px_400px_at_-5%_20%,#f6e7c7_0%,transparent_55%)]"
    >
    </div>

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
