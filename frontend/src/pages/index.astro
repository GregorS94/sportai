---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostCard from "~/components/PostCard.astro";
import BlockRenderer from "~/components/BlockRenderer.astro";
import { cms, safe } from "~/lib/cms";

const [{ items: latestPosts }, homePage] = await Promise.all([
  safe(cms.posts({ limit: 4 }), { items: [], total: 0, limit: 4, offset: 0 }),
  safe(cms.page("home"), null),
]);

const hasHomeBlocks = Array.isArray(homePage?.blocks) && homePage!.blocks.length > 0;

// Principles and offerings are placeholders — real copy lives in the CMS
// (create pages with the matching slugs and the section will read them).
// For now we use the structure so his wife can see the layout.
const principles = [
  {
    num: "01",
    title: "Bindungsorientiert",
    text: "Heilung passiert in Beziehung — zuerst zu dir selbst, dann zu anderen.",
  },
  {
    num: "02",
    title: "Entwicklungsorientiert",
    text: "Wir schauen nach vorn, ohne das Alte zu überspringen.",
  },
  {
    num: "03",
    title: "Körper & Nervensystem",
    text: "Dein Körper ist kein Problem. Er ist Kompass und Verbündeter.",
  },
];

const offers = [
  {
    slug: "1-1-recovery-begleitung",
    label: "1:1 Coaching",
    title: "1:1 Recovery Begleitung",
    text: "Ein vertraulicher Raum für deinen Weg – in deinem Tempo, mit echtem Gegenüber.",
    href: "/recovery-begleitung",
  },
  {
    slug: "trauma-nervensystem",
    label: "Körperarbeit",
    title: "1:1 Trauma- & Nervensystem-Arbeit",
    text: "Innere Arbeit, die an der Wurzel ansetzt – dort wo Worte nicht mehr reichen.",
    href: "/trauma-nervensystem",
  },
  {
    slug: "free-your-self",
    label: "Gruppenprogramm",
    title: "Free Your Self",
    text: "Online-Coaching für Frauen, die bereit sind, anzufangen. In Runden mit Begleitung.",
    href: "/free-your-self",
  },
];
---

<BaseLayout
  title={homePage?.meta?.title || "Trauma und Essstörung"}
  description={homePage?.meta?.description || "Bindungs- und entwicklungsorientierte Innere Arbeit als Lösungsstrategie. Ein Leben ohne Essstörung ist möglich."}
>
  {hasHomeBlocks ? (
    <>
      <BlockRenderer blocks={homePage!.blocks} />
      {latestPosts.length > 0 && (
        <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
          <div class="flex items-end justify-between flex-wrap gap-4 mb-12">
            <div>
              <span class="eyebrow">Seelenblog</span>
              <h2 class="mt-3">Zuletzt geschrieben</h2>
            </div>
            <a href="/blog" class="text-sm underline underline-offset-4 decoration-[color:var(--color-clay)] hover:text-[color:var(--color-clay)]">Alle Beiträge →</a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {latestPosts.slice(0, 3).map((p) => <PostCard post={p} />)}
          </div>
        </section>
      )}
    </>
  ) : (
    <>
  <!-- ========================================================== -->
  <!-- HERO                                                         -->
  <!-- ========================================================== -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-14 lg:pt-20 pb-20 lg:pb-28">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-10 items-center">
        <!-- copy -->
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="rise eyebrow">Seelenmut · Julia</div>
          <h1 class="rise rise-1 mt-6">
            Trauma und<br />
            <span class="display-italic text-[color:var(--color-clay)]">Essstörung.</span>
          </h1>
          <p class="rise rise-2 mt-8 max-w-xl text-lg text-[color:var(--color-mute)] leading-relaxed">
            Bindungs- und entwicklungsorientierte Innere Arbeit als
            Lösungsstrategie. Ein Leben ohne Essstörung ist möglich.
          </p>
          <div class="rise rise-3 mt-10 flex items-center gap-3 flex-wrap">
            <a
              href="/kontakt"
              class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] px-8 py-4 text-sm font-medium hover:bg-[color:var(--color-clay)] transition"
            >
              Kostenloses Kennenlerngespräch
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="/ueber-mich"
              class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/60 backdrop-blur px-7 py-4 text-sm font-medium text-[color:var(--color-ink)] hover:border-[color:var(--color-ink)] transition"
            >
              Über mich
            </a>
          </div>
          <div class="rise rise-4 mt-12 flex items-center gap-6 text-xs text-[color:var(--color-mute)]">
            <span class="flex items-center gap-2">
              <span class="inline-block h-[6px] w-[6px] rounded-full bg-[color:var(--color-sage)]"></span>
              Psychologin
            </span>
            <span class="flex items-center gap-2">
              <span class="inline-block h-[6px] w-[6px] rounded-full bg-[color:var(--color-sage)]"></span>
              Ernährungstrainerin
            </span>
            <span class="flex items-center gap-2">
              <span class="inline-block h-[6px] w-[6px] rounded-full bg-[color:var(--color-sage)]"></span>
              Autorin
            </span>
          </div>
        </div>

        <!-- portrait placeholder (editor will replace with real photo) -->
        <div class="lg:col-span-5 order-1 lg:order-2">
          <div class="relative mx-auto max-w-sm lg:max-w-none">
            <div class="arch-frame aspect-[4/5] bg-gradient-to-br from-[color:var(--color-bg-3)] via-[color:var(--color-butter)] to-[color:var(--color-clay-soft)] relative">
              <svg
                class="absolute inset-0 m-auto w-24 h-24 text-[color:var(--color-clay)]/40"
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
              >
                <circle cx="32" cy="22" r="9" />
                <path d="M12 56 C 14 40, 20 34, 32 34 S 50 40, 52 56" />
              </svg>
              <span class="absolute bottom-4 left-4 right-4 text-center text-[10px] font-mono uppercase tracking-widest text-[color:var(--color-clay)]/70">
                Portrait · aus dem CMS austauschbar
              </span>
            </div>
            <!-- floating label -->
            <div class="absolute -bottom-5 -left-4 sm:-left-8 bg-[color:var(--color-ink)] text-[color:var(--color-bg)] rounded-full px-5 py-2 text-xs font-mono uppercase tracking-widest shadow-[0_20px_40px_rgba(31,25,18,0.2)]">
              Hey, ich bin Julia
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- marquee strip -->
    <div class="border-y border-[color:var(--color-line)] bg-[color:var(--color-bg-2)]/40 overflow-hidden">
      <div class="flex gap-12 py-4 marquee-track whitespace-nowrap text-[color:var(--color-ink-2)] font-display italic text-xl">
        {
          Array.from({ length: 2 }).map(() => (
            <div class="flex gap-12 shrink-0">
              <span>Recovery ist möglich.</span>
              <span class="text-[color:var(--color-clay)]">✦</span>
              <span>Du darfst langsam sein.</span>
              <span class="text-[color:var(--color-clay)]">✦</span>
              <span>Bindung vor Methode.</span>
              <span class="text-[color:var(--color-clay)]">✦</span>
              <span>Der Körper erinnert sich.</span>
              <span class="text-[color:var(--color-clay)]">✦</span>
              <span>Kein Schritt ist zu klein.</span>
              <span class="text-[color:var(--color-clay)]">✦</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================== -->
  <!-- MEINE PRINZIPIEN                                             -->
  <!-- ========================================================== -->
  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <span class="eyebrow">Meine Prinzipien</span>
          <h2 class="mt-4">Woran ich<br /><span class="display-italic">glaube.</span></h2>
          <p class="mt-6 text-[color:var(--color-mute)] max-w-sm">
            Drei Grundpfeiler, die meine Arbeit tragen – und die du in jedem
            Kontakt mit mir spürst.
          </p>
        </div>
      </div>

      <div class="lg:col-span-8 grid gap-4">
        {
          principles.map((p) => (
            <article class="group rounded-3xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur p-8 md:p-10 hover:border-[color:var(--color-ink)] transition">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-mono text-xs tracking-widest text-[color:var(--color-clay)]">
                  {p.num}
                </span>
                <span class="h-px flex-1 bg-[color:var(--color-line)]" />
              </div>
              <h3 class="mt-4 font-display">{p.title}</h3>
              <p class="mt-3 text-[color:var(--color-mute)] leading-relaxed max-w-2xl">
                {p.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================== -->
  <!-- OFFERS (bento)                                               -->
  <!-- ========================================================== -->
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-24 lg:pb-32">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
      <div>
        <span class="eyebrow">So kann ich dich begleiten</span>
        <h2 class="mt-3">Meine Angebote</h2>
      </div>
      <a
        href="/angebote"
        class="text-sm underline underline-offset-4 decoration-[color:var(--color-clay)] hover:text-[color:var(--color-clay)]"
      >
        Alle Angebote ansehen →
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-6 md:grid-rows-2">
      <!-- Big feature tile -->
      <a
        href={offers[0].href}
        class="group relative md:col-span-4 md:row-span-2 rounded-3xl overflow-hidden p-8 md:p-12 bg-[color:var(--color-ink)] text-[color:var(--color-bg)] min-h-[340px] flex flex-col justify-between"
      >
        <div>
          <span class="eyebrow" style="color:var(--color-clay-soft)">
            {offers[0].label}
          </span>
          <h3 class="mt-4 font-display text-3xl md:text-5xl leading-[1.05] text-[color:var(--color-bg)]">
            {offers[0].title}
          </h3>
        </div>
        <div class="flex items-end justify-between gap-6">
          <p class="text-[color:var(--color-bg-2)] max-w-md leading-relaxed">
            {offers[0].text}
          </p>
          <span class="shrink-0 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[color:var(--color-bg)]/30 group-hover:bg-[color:var(--color-clay)] group-hover:border-[color:var(--color-clay)] transition">
            <span aria-hidden="true">→</span>
          </span>
        </div>
        <!-- decorative glyph -->
        <span class="absolute -right-10 -top-10 font-display text-[240px] leading-none text-[color:var(--color-clay)]/20 select-none pointer-events-none">
          s
        </span>
      </a>

      <!-- Secondary tile 1 -->
      <a
        href={offers[1].href}
        class="group relative md:col-span-2 rounded-3xl overflow-hidden p-8 bg-[color:var(--color-butter)] min-h-[180px] flex flex-col justify-between hover:bg-[color:var(--color-clay-soft)] transition"
      >
        <div>
          <span class="eyebrow">{offers[1].label}</span>
          <h3 class="mt-3 font-display text-xl md:text-2xl leading-[1.1]">
            {offers[1].title}
          </h3>
        </div>
        <p class="text-sm text-[color:var(--color-ink-2)] leading-relaxed mt-4">
          {offers[1].text}
        </p>
      </a>

      <!-- Secondary tile 2 -->
      <a
        href={offers[2].href}
        class="group relative md:col-span-2 rounded-3xl overflow-hidden p-8 border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur min-h-[180px] flex flex-col justify-between hover:border-[color:var(--color-ink)] transition"
      >
        <div>
          <span class="eyebrow">{offers[2].label}</span>
          <h3 class="mt-3 font-display text-xl md:text-2xl leading-[1.1]">
            {offers[2].title}
          </h3>
        </div>
        <p class="text-sm text-[color:var(--color-mute)] leading-relaxed mt-4">
          {offers[2].text}
        </p>
      </a>
    </div>
  </section>

  <!-- ========================================================== -->
  <!-- ABOUT teaser                                                 -->
  <!-- ========================================================== -->
  <section class="bg-[color:var(--color-bg-2)]/50 border-y border-[color:var(--color-line)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32 grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-5">
        <div class="arch-frame aspect-[4/5] max-w-sm mx-auto bg-gradient-to-br from-[color:var(--color-clay-soft)] via-[color:var(--color-butter)] to-[color:var(--color-bg-3)] relative">
          <span class="absolute bottom-4 left-0 right-0 text-center text-[10px] font-mono uppercase tracking-widest text-[color:var(--color-clay)]/70">
            Portrait · CMS-Medien
          </span>
        </div>
      </div>
      <div class="lg:col-span-7">
        <span class="eyebrow">Hey</span>
        <h2 class="mt-4">
          Ich bin <span class="display-italic text-[color:var(--color-clay)]">Julia.</span>
        </h2>
        <p class="mt-6 text-lg text-[color:var(--color-ink-2)] max-w-xl leading-relaxed">
          Diplomierte Lern-Pädagogin, Autorin, Psychologin und Ernährungstrainerin.
          Ich begleite Menschen aus der Essstörung – ehrlich, zugewandt, mit
          tiefem Verständnis für den Weg dahinter.
        </p>
        <p class="mt-4 text-[color:var(--color-mute)] max-w-xl text-sm italic">
          Diese kurze Einleitung ist ein Platzhalter. Der vollständige Text
          deiner „Über mich"-Seite lebt im CMS unter dem Slug <code
            class="font-mono text-xs bg-[color:var(--color-bg)] px-1.5 py-0.5 rounded">ueber-mich</code
          >.
        </p>
        <a
          href="/ueber-mich"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] px-7 py-3 text-sm font-medium hover:bg-[color:var(--color-clay)] transition"
        >
          Meine Geschichte →
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================================== -->
  <!-- LATEST POSTS                                                 -->
  <!-- ========================================================== -->
  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
        <div class="flex items-end justify-between flex-wrap gap-4 mb-12">
          <div>
            <span class="eyebrow">Seelenblog</span>
            <h2 class="mt-3">Zuletzt geschrieben</h2>
          </div>
          <a
            href="/blog"
            class="text-sm underline underline-offset-4 decoration-[color:var(--color-clay)] hover:text-[color:var(--color-clay)]"
          >
            Alle Beiträge →
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latestPosts.slice(0, 3).map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )
  }

  {
    latestPosts.length === 0 && (
      <section class="mx-auto max-w-3xl px-6 py-24 text-center">
        <span class="eyebrow">Seelenblog</span>
        <h2 class="mt-3">Der erste Eintrag entsteht gerade.</h2>
        <p class="mt-4 text-[color:var(--color-mute)]">
          Sobald der erste Beitrag im CMS veröffentlicht ist, erscheint er hier.
        </p>
      </section>
    )
  }

  <!-- ========================================================== -->
  <!-- CTA band                                                     -->
  <!-- ========================================================== -->
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-24 lg:pb-32">
    <div
      class="relative overflow-hidden rounded-3xl bg-[color:var(--color-ink)] text-[color:var(--color-bg)] p-10 md:p-16 text-center"
    >
      <span class="eyebrow" style="color:var(--color-clay-soft)">Nächster Schritt</span>
      <h2 class="mt-4 font-display text-[color:var(--color-bg)]">
        Magst du schreiben?
      </h2>
      <p class="mt-6 max-w-xl mx-auto text-[color:var(--color-bg-2)] leading-relaxed">
        Manchmal ist der erste Schritt ein einziger Satz. Er darf tastend sein,
        leise, unsicher. Ich lese ihn trotzdem.
      </p>
      <a
        href="/kontakt"
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-clay)] text-[color:var(--color-bg)] px-8 py-4 text-sm font-medium hover:bg-[color:var(--color-clay-hover)] transition"
      >
        Kostenloses Kennenlerngespräch →
      </a>

      <!-- decorative big glyph -->
      <span class="absolute -right-16 -bottom-16 font-display italic text-[320px] leading-none text-[color:var(--color-clay)]/15 select-none pointer-events-none">
        ,
      </span>
    </div>
  </section>
    </>
  )}
</BaseLayout>
