---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostCard from "~/components/PostCard.astro";
import { cms, safe } from "~/lib/cms";

const { items: latestPosts } = await safe(cms.posts({ limit: 3 }), {
  items: [],
  total: 0,
  limit: 3,
  offset: 0,
});
---

<BaseLayout
  title="Ein Leben ohne Essstörung ist möglich"
  description="Seelenmut begleitet dich auf dem Weg aus der Essstörung – ehrlich, zugewandt und in deinem Tempo."
>
  <!-- Hero -->
  <section class="relative">
    <div class="mx-auto max-w-5xl px-6 pt-16 pb-16 md:pt-20 md:pb-20 text-center">
      <div class="rise">
        <span
          class="inline-block text-xs uppercase tracking-[0.25em] text-[color:var(--color-clay)] mb-5"
          >Seelenmut · Recovery &amp; Begleitung</span
        >
      </div>
      <h1 class="rise rise-delay-1 max-w-3xl mx-auto">
        Ein Leben ohne Essstörung<br />
        <em class="italic text-[color:var(--color-clay)]">ist möglich.</em>
      </h1>
      <p
        class="rise rise-delay-2 mt-8 max-w-xl mx-auto text-lg text-[color:var(--color-mute)] leading-relaxed"
      >
        Dieser Weg ist leise, manchmal steinig – aber du musst ihn nicht allein
        gehen. Seelenmut ist ein Ort zum Atmen, Sortieren und Wieder-Vertrauen.
      </p>
      <div class="rise rise-delay-3 mt-10 flex items-center justify-center gap-3 flex-wrap">
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-bark)] text-white px-7 py-3 text-sm font-medium hover:bg-[color:var(--color-bark-dark)] transition shadow-[0_10px_30px_rgba(107,91,69,0.18)]"
        >
          Kostenloses Kennenlerngespräch →
        </a>
        <a
          href="/ueber-mich"
          class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white/60 backdrop-blur px-7 py-3 text-sm font-medium text-[color:var(--color-bark)] hover:bg-white transition"
        >
          Meine Geschichte
        </a>
      </div>
    </div>
  </section>

  <!-- Quiet intro / "Du darfst hier sein" -->
  <section class="mx-auto max-w-3xl px-6 pb-20">
    <div
      class="rounded-3xl bg-white/70 backdrop-blur border border-[color:var(--color-border)] p-10 md:p-14 text-center"
    >
      <div class="text-2xl text-[color:var(--color-clay)]">❋</div>
      <p class="mt-5 font-serif text-2xl md:text-3xl text-[color:var(--color-bark)] leading-snug">
        Du darfst hier sein – genau so, wie es dir heute geht.
      </p>
      <p class="mt-5 text-[color:var(--color-mute)] leading-relaxed">
        Ob mittendrin, kurz davor loszugehen oder als Angehörige*r, der:die einen
        Menschen begleitet: Auf diesen Seiten findest du Gedanken, Impulse und
        einen sanften Rahmen, in dem Heilung passieren darf.
      </p>
    </div>
  </section>

  <!-- Offering teaser -->
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid md:grid-cols-3 gap-6">
      {[
        {
          mark: "❋",
          title: "1:1 Coaching",
          text: "Ein vertraulicher Raum, in dem du dein Tempo bestimmst. Wir schauen gemeinsam, was dich hält und was dich weiterträgt.",
          href: "/coaching",
          cta: "Mehr erfahren",
        },
        {
          mark: "✦",
          title: "Journal & Impulse",
          text: "Kurze Texte über Recovery, Selbstwert, Ernährung und die leisen Schritte dazwischen – zum Lesen, wenn du es brauchst.",
          href: "/blog",
          cta: "Zum Journal",
        },
        {
          mark: "❀",
          title: "Du willst schreiben?",
          text: "Manchmal ist der erste Schritt ein einziger Satz. Schreib mir – unverbindlich, ohne Druck, ohne Erwartung.",
          href: "/kontakt",
          cta: "Kontakt aufnehmen",
        },
      ].map((v) => (
        <a
          href={v.href}
          class="group rounded-2xl border border-[color:var(--color-border)] bg-white/70 backdrop-blur p-7 hover:bg-white hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(43,42,38,0.08)] transition-all"
        >
          <div class="text-2xl text-[color:var(--color-clay)]">{v.mark}</div>
          <h3 class="mt-3 font-serif text-2xl">{v.title}</h3>
          <p class="mt-2 text-sm text-[color:var(--color-mute)] leading-relaxed">
            {v.text}
          </p>
          <span class="mt-4 inline-block text-sm text-[color:var(--color-bark)] group-hover:text-[color:var(--color-clay)] underline underline-offset-4 decoration-[color:var(--color-clay)]">
            {v.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest posts -->
  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 pb-24">
        <div class="flex items-end justify-between mb-10 flex-wrap gap-3">
          <div>
            <span class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-clay)]">
              Aus dem Journal
            </span>
            <h2 class="mt-2">Zuletzt geschrieben</h2>
          </div>
          <a
            href="/blog"
            class="text-sm text-[color:var(--color-bark)] hover:text-[color:var(--color-clay)] underline underline-offset-4 decoration-[color:var(--color-clay)]"
          >
            Alle Beiträge →
          </a>
        </div>
        <div class="grid gap-8">
          {latestPosts[0] && <PostCard post={latestPosts[0]} featured />}
          {latestPosts.length > 1 && (
            <div class="grid md:grid-cols-2 gap-8">
              {latestPosts.slice(1).map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    latestPosts.length === 0 && (
      <section class="mx-auto max-w-3xl px-6 pb-24 text-center">
        <div class="rounded-2xl border border-dashed border-[color:var(--color-border)] bg-white/50 p-12">
          <div class="text-3xl text-[color:var(--color-clay)]">❋</div>
          <p class="mt-4 font-serif text-2xl text-[color:var(--color-bark)]">
            Das Journal wartet auf seinen ersten Eintrag.
          </p>
          <p class="mt-2 text-sm text-[color:var(--color-mute)]">
            Sobald der erste Beitrag im CMS veröffentlicht ist, erscheint er hier.
          </p>
        </div>
      </section>
    )
  }

  <!-- Closing encouragement -->
  <section class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <p class="font-serif text-2xl md:text-3xl text-[color:var(--color-bark)] italic leading-snug">
      „Mut bedeutet nicht, keine Angst zu haben.<br />
      Mut bedeutet, trotzdem einen Schritt zu gehen."
    </p>
    <a
      href="/kontakt"
      class="mt-8 inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white px-6 py-3 text-sm text-[color:var(--color-bark)] hover:border-[color:var(--color-clay)] hover:text-[color:var(--color-clay)] transition"
    >
      Schreib mir →
    </a>
  </section>
</BaseLayout>
