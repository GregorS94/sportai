---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cms, safe } from "~/lib/cms";

const page = await safe(cms.page("recovery-begleitung"), null);
const hasContent = page?.content_html && page.content_html.trim().length > 0;

const defaults = {
  title: "1:1 Recovery Begleitung",
  excerpt: "Lerne dich wieder in dir selbst zuhause zu fühlen.",
  description: "Individuelle Begleitung aus der Essstörung. Bindungsorientiert, in deinem Tempo.",
};

const title = page?.title || defaults.title;
const excerpt = page?.excerpt || defaults.excerpt;
const desc = page?.meta?.description || defaults.description;

const testimonials = [
  "Julia, ich muss dir schnell kurz was berichten, weil es einfach gerade so eine krasse Erfahrung für mich ist 😍 Ich höre plötzlich Dinge. Also alltägliche Dinge. Das Auto auf der Straße. Meine Schritte, wenn ich über den Teppich laufe. Diese Geräusche habe ich NIE wahrgenommen. Aber seit unserer Session heute Morgen ist eine derartige Ruhe in meinem Kopf... Wow. Das fühlt sich einfach nur toll an 😭🫶",
  "Danke dir nochmal sehr für all deine Unterstützung auch jetzt in dieser schweren Zeit die letzten Monate 🙏 du warst einen riesen Stütze für mich, ohne die es sicher nicht so leicht gewesen wäre. Ehrlich gesagt weiß ich nicht mal, ob ich ohne deine ganze gemeinsame Arbeit den Mut gehabt hätte mich zu trennen. Deshalb wirklich vielen Dank von ganzem Herzen 🤎",
  "Julia, das ist so Wahnsinn, wenn du mir das erzählt hättest als wir uns kennengelernt haben, hätte meine ganze Gefühlswelt alarm geschlagen, dass man so alleine lässt und jetzt bin ich einfach so zu frieden:)",
  "Ich hatte das große Glück, über mehrere Monate an einem 1:1 Coaching bei Julia teilnehmen zu dürfen. Mit ihrer liebevollen und empathischen Art hat sie mich begleitet, unterstützt und in schwierigen Momenten aufgefangen. Besonders war auch die 24/7-Begleitung über WhatsApp, die mir das Gefühl von Sicherheit und Geborgenheit gab. Ich kann Julia von Herzen weiterempfehlen!",
];

const coachingStructure = [
  { label: "1:1 Coachingstunden", icon: "📋" },
  { label: "Tägliche Betreuung zu jeder Zeit", icon: "💬" },
  { label: "Hunger natürliche Liebe", icon: "💗" },
  { label: "Lebenslauf & Co Paket", icon: "📦" },
];
---

<BaseLayout title={title} description={desc}>
  <!-- Hero -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-14 lg:pt-20 pb-20">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="eyebrow">1:1 Coaching</span>
          <h1 class="mt-6">
            Lerne dich wieder in dir selbst<br />
            <span class="display-italic text-[color:var(--color-clay)]">zuhause zu fühlen.</span>
          </h1>
          <p class="mt-8 max-w-xl text-lg text-[color:var(--color-mute)] leading-relaxed">
            {excerpt}
          </p>
          <div class="mt-10">
            <a href="/kontakt" class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] px-8 py-4 text-sm font-medium hover:bg-[color:var(--color-clay)] transition">
              Kostenloses Kennenlerngespräch <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="arch-frame aspect-[4/5] bg-gradient-to-br from-[color:var(--color-bg-3)] via-[color:var(--color-butter)] to-[color:var(--color-clay-soft)] relative">
            <span class="absolute bottom-4 left-0 right-0 text-center text-[10px] font-mono uppercase tracking-widest text-[color:var(--color-clay)]/70">
              Portrait · CMS-Medien
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content from CMS -->
  <section class="border-y border-[color:var(--color-line)] bg-[color:var(--color-bg-2)]/40">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20">
      {hasContent ? (
        <div class="prose mx-auto" set:html={page!.content_html} />
      ) : (
        <div class="prose mx-auto">
          <h2>Mein Motto: Ein Leben ohne Essstörung ist für jeden möglich!</h2>
          <p>Ich begleite dich als Expertin, aber auch als Mensch. Mein Ziel ist es, dich zu verstehen und dir einen sicheren Raum zu geben.</p>
          <h2>Woran du arbeiten wirst</h2>
          <h3>Das heile Wesen und Urvertrauen</h3>
          <p>Empathisch kehren wir zum originalen Teil deines Wesens zurück. Verschüttete, gute, noch nicht gelebte Gefühle und Bedürfnisse. Nur durch den Kontakt mit den inneren Kindern kann Heilung gelingen.</p>
          <h3>Deinen Alltag und Hindernisse</h3>
          <p>Durch den täglichen Kontakt helfe ich dir, Hindernisse in deinem Alltag zu erkennen und Lösungen zu finden.</p>
          <h3>Selbstregulation und Emotionsmanagement</h3>
          <p>Dein Nervensystem sorgt dafür, dass extreme Reaktionen entstehen. Gemeinsam lernen wir neue Wege der Selbstregulation.</p>
          <h3>Nervensystem und Körperkompetenz</h3>
          <p>Mein Herzstück ist die Trauma- und Nervensystemarbeit. Alle Praktiken sind darauf ausgelegt, dich wieder mit deinem Körper als Freund zu verbinden.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Coaching Aufbau -->
  <section class="mx-auto max-w-5xl px-6 lg:px-10 py-24">
    <div class="text-center mb-14">
      <span class="eyebrow">Struktur</span>
      <h2 class="mt-4">Aufbau des 1:1 <span class="display-italic">Coachings.</span></h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {coachingStructure.map((item) => (
        <div class="rounded-3xl bg-[color:var(--color-clay)] text-[color:var(--color-bg)] p-8 text-center hover:bg-[color:var(--color-clay-hover)] transition">
          <div class="text-3xl mb-4">{item.icon}</div>
          <p class="font-display text-lg">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-[color:var(--color-bg-2)]/50 border-y border-[color:var(--color-line)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
      <div class="text-center mb-14">
        <span class="eyebrow">Erfahrungen</span>
        <h2 class="mt-4">Das sagen Seelenmut <span class="display-italic">Klienten.</span></h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {testimonials.map((t) => (
          <article class="rounded-3xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur p-8">
            <div class="text-[color:var(--color-clay)] text-2xl mb-4">„</div>
            <p class="text-[color:var(--color-ink-2)] leading-relaxed text-sm">{t}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-6 lg:px-10 py-24">
    <div class="relative overflow-hidden rounded-3xl bg-[color:var(--color-ink)] text-[color:var(--color-bg)] p-10 md:p-16 text-center">
      <span class="eyebrow" style="color:var(--color-clay-soft)">Nächster Schritt</span>
      <h2 class="mt-4 font-display text-[color:var(--color-bg)]">Bereit für dein Kennenlerngespräch?</h2>
      <p class="mt-6 max-w-xl mx-auto text-[color:var(--color-bg-2)] leading-relaxed">
        Unverbindlich, kostenlos, vertraulich.
      </p>
      <a href="/kontakt" class="mt-10 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-clay)] text-[color:var(--color-bg)] px-8 py-4 text-sm font-medium hover:bg-[color:var(--color-clay-hover)] transition">
        Kostenloses Kennenlerngespräch <span aria-hidden="true">→</span>
      </a>
      <span class="absolute -right-16 -bottom-16 font-display italic text-[320px] leading-none text-[color:var(--color-clay)]/15 select-none pointer-events-none">s</span>
    </div>
  </section>
</BaseLayout>
