---
import { cms, safe, type CmsPage } from "~/lib/cms";

const staticLinks: { href: string; label: string }[] = [
  { href: "/ueber-mich", label: "Über mich" },
  { href: "/angebote", label: "Angebote" },
  { href: "/free-your-self", label: "Free Your Self" },
  { href: "/blog", label: "Seelenblog" },
];

const cmsPages: CmsPage[] = await safe(cms.menuPages(), []);
const reserved = new Set([
  "",
  "ueber-mich",
  "angebote",
  "free-your-self",
  "blog",
  "kontakt",
  "impressum",
  "datenschutz",
]);
const extraLinks = cmsPages
  .filter((p) => p.show_in_menu && !reserved.has(p.slug))
  .map((p) => ({ href: `/${p.slug}`, label: p.title }));

const links = [...staticLinks, ...extraLinks];
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-30 backdrop-blur-md bg-[color:var(--color-bg)]/75 border-b border-[color:var(--color-line-soft)]">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex items-center justify-between gap-6 py-4">
      <a href="/" class="group flex items-center gap-3">
        <span
          class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[color:var(--color-clay)] text-[color:var(--color-bg)] font-display text-lg"
          aria-hidden="true">s</span
        >
        <span class="flex flex-col leading-none">
          <span class="font-display text-xl tracking-tight text-[color:var(--color-ink)] group-hover:text-[color:var(--color-clay)] transition">
            Seelenmut
          </span>
          <span class="eyebrow mt-1 hidden sm:inline" style="color:var(--color-mute)">
            Trauma · Recovery · Begleitung
          </span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1 text-sm">
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                "px-3 py-2 rounded-full transition relative",
                isActive(l.href)
                  ? "text-[color:var(--color-ink)]"
                  : "text-[color:var(--color-mute)] hover:text-[color:var(--color-ink)]",
              ]}
            >
              {l.label}
              {isActive(l.href) && (
                <span class="absolute left-3 right-3 -bottom-0.5 h-[2px] bg-[color:var(--color-clay)] rounded-full" />
              )}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/kontakt"
          class:list={[
            "hidden sm:inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition",
            isActive("/kontakt")
              ? "bg-[color:var(--color-clay)] text-[color:var(--color-bg)]"
              : "bg-[color:var(--color-ink)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay)]",
          ]}
        >
          Kontakt <span aria-hidden="true">→</span>
        </a>

        <!-- mobile menu toggle -->
        <button
          type="button"
          class="md:hidden rounded-full border border-[color:var(--color-line)] p-2"
          aria-label="Menü"
          onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>
      </div>
    </div>

    <!-- mobile menu -->
    <nav id="mobile-menu" class="md:hidden hidden pb-4 flex flex-col gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "px-3 py-2.5 rounded-xl text-sm",
              isActive(l.href)
                ? "bg-[color:var(--color-bg-2)] text-[color:var(--color-ink)]"
                : "text-[color:var(--color-mute)] hover:bg-[color:var(--color-bg-2)]",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/kontakt"
        class="mt-2 px-3 py-2.5 rounded-xl bg-[color:var(--color-ink)] text-[color:var(--color-bg)] text-sm text-center"
        >Kontakt →</a
      >
    </nav>
  </div>

</header>
