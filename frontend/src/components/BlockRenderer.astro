---
/**
 * Renders an array of CMS blocks with the Seelenmut editorial design.
 * Block types: hero, text, cards, testimonials, cta, image
 */
export interface Props {
  blocks: any[];
}

const { blocks = [] } = Astro.props;
---

{blocks.map((block: any) => {
  if (block.type === "hero") return (
    <section class="relative">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-14 lg:pt-20 pb-20">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-10 items-center">
          <div class={block.image ? "lg:col-span-7" : "lg:col-span-10"}>
            {block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
            {block.title && <h1 class="mt-6"><span class="display-italic text-[color:var(--color-clay)]">{block.title}</span></h1>}
            {block.subtitle && <p class="mt-8 max-w-xl text-lg text-[color:var(--color-mute)] leading-relaxed">{block.subtitle}</p>}
            {block.cta_text && block.cta_href && (
              <div class="mt-10">
                <a href={block.cta_href} class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] px-8 py-4 text-sm font-medium hover:bg-[color:var(--color-clay)] transition">
                  {block.cta_text} <span aria-hidden="true">→</span>
                </a>
              </div>
            )}
          </div>
          {block.image && (
            <div class="lg:col-span-5">
              <div class="arch-frame aspect-[4/5] overflow-hidden">
                <img src={block.image} alt="" class="w-full h-full object-cover" />
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  );

  if (block.type === "text") return (
    <section class="mx-auto max-w-3xl px-6 lg:px-10 py-16">
      <div class="prose mx-auto" set:html={block.content_html || block.content || ""} />
    </section>
  );

  if (block.type === "cards") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [title, text, href] = line.split("|").map((s: string) => s.trim());
      return { title, text, href };
    });
    return (
      <section class="mx-auto max-w-5xl px-6 lg:px-10 py-16">
        {block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
        {block.title && <h2 class="mt-4 mb-10">{block.title}</h2>}
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {items.map((item: any) => (
            <a href={item.href || "#"} class="group rounded-3xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur p-8 hover:border-[color:var(--color-ink)] transition block">
              {item.title && <h3 class="font-display text-lg">{item.title}</h3>}
              {item.text && <p class="mt-3 text-[color:var(--color-mute)] text-sm leading-relaxed">{item.text}</p>}
            </a>
          ))}
        </div>
      </section>
    );
  }

  if (block.type === "testimonials") {
    const items = (block.items || "").split("\n\n").filter((t: string) => t.trim());
    return (
      <section class="bg-[color:var(--color-bg-2)]/50 border-y border-[color:var(--color-line)]">
        <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
          {block.title && (
            <div class="text-center mb-14">
              <span class="eyebrow">Erfahrungen</span>
              <h2 class="mt-4">{block.title}</h2>
            </div>
          )}
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {items.map((t: string) => (
              <article class="rounded-3xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur p-8">
                <div class="text-[color:var(--color-clay)] text-2xl mb-4">„</div>
                <p class="text-[color:var(--color-ink-2)] leading-relaxed text-sm">{t.trim()}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (block.type === "cta") {
    const isDark = (block.style || "dark") === "dark";
    return (
      <section class="mx-auto max-w-5xl px-6 lg:px-10 py-16">
        <div class:list={[
          "relative overflow-hidden rounded-3xl p-10 md:p-16 text-center",
          isDark ? "bg-[color:var(--color-ink)] text-[color:var(--color-bg)]" : "bg-[color:var(--color-bg-2)] border border-[color:var(--color-line)]"
        ]}>
          {block.eyebrow && <span class="eyebrow" style={isDark ? "color:var(--color-clay-soft)" : undefined}>{block.eyebrow}</span>}
          {block.title && <h2 class:list={["mt-4 font-display", isDark ? "text-[color:var(--color-bg)]" : ""]}>{block.title}</h2>}
          {block.text && <p class:list={["mt-6 max-w-xl mx-auto leading-relaxed", isDark ? "text-[color:var(--color-bg-2)]" : "text-[color:var(--color-mute)]"]}>{block.text}</p>}
          {block.cta_text && block.cta_href && (
            <a href={block.cta_href} class:list={[
              "mt-10 inline-flex items-center gap-2 rounded-full px-8 py-4 text-sm font-medium transition",
              isDark ? "bg-[color:var(--color-clay)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay-hover)]" : "bg-[color:var(--color-ink)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay)]"
            ]}>
              {block.cta_text} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </section>
    );
  }

  if (block.type === "marquee") {
    const items = (block.items || "").split("|").map((s: string) => s.trim()).filter(Boolean);
    if (!items.length) return null;
    return (
      <div class="border-y border-[color:var(--color-line)] bg-[color:var(--color-bg-2)]/40 overflow-hidden">
        <div class="flex gap-12 py-4 marquee-track whitespace-nowrap text-[color:var(--color-ink-2)] font-display italic text-xl">
          {Array.from({ length: 2 }).map(() => (
            <div class="flex gap-12 shrink-0">
              {items.map((item: string, i: number) => (
                <>
                  <span>{item}</span>
                  <span class="text-[color:var(--color-clay)]">✦</span>
                </>
              ))}
            </div>
          ))}
        </div>
      </div>
    );
  }

  if (block.type === "feature") {
    const isDark = (block.style || "dark") === "dark";
    const bullets = (block.bullets || "").split("\n").filter((l: string) => l.trim());
    return (
      <section class="mx-auto max-w-5xl px-6 lg:px-10 py-16">
        <div class:list={[
          "relative overflow-hidden rounded-3xl p-10 md:p-16",
          isDark ? "bg-[color:var(--color-ink)] text-[color:var(--color-bg)]" : "bg-[color:var(--color-bg-2)] border border-[color:var(--color-line)]"
        ]}>
          {block.eyebrow && <span class="eyebrow" style={isDark ? "color:var(--color-clay)" : undefined}>{block.eyebrow}</span>}
          {block.title && <h2 class:list={["mt-4 font-display text-4xl", isDark ? "text-[color:var(--color-bg)]" : ""]}>{block.title}</h2>}
          {block.text && <p class:list={["mt-6 max-w-2xl leading-relaxed", isDark ? "text-[color:var(--color-bg-2)]" : "text-[color:var(--color-mute)]"]}>{block.text}</p>}
          {bullets.length > 0 && (
            <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3 max-w-2xl">
              {bullets.map((b: string) => (
                <li class:list={["flex items-start gap-2 text-sm", isDark ? "text-[color:var(--color-bg-2)]" : "text-[color:var(--color-mute)]"]}>
                  <span class="mt-1 shrink-0 w-2 h-2 rounded-full bg-[color:var(--color-clay)]" aria-hidden="true" />
                  {b.trim()}
                </li>
              ))}
            </ul>
          )}
          {block.cta_text && block.cta_href && (
            <a href={block.cta_href} class:list={[
              "mt-10 inline-flex items-center gap-2 rounded-full px-8 py-4 text-sm font-medium transition",
              isDark ? "bg-[color:var(--color-clay)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay-hover)]" : "bg-[color:var(--color-ink)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay)]"
            ]}>
              {block.cta_text} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </section>
    );
  }

  if (block.type === "image") return (
    <section class="mx-auto max-w-4xl px-6 lg:px-10 py-16">
      {block.src && (
        <figure>
          <img src={block.src} alt={block.alt || ""} class="w-full rounded-2xl" />
          {block.caption && <figcaption class="mt-3 text-center text-sm text-[color:var(--color-mute)]">{block.caption}</figcaption>}
        </figure>
      )}
    </section>
  );

  if (block.type === "person") return (
    <section class="bg-[color:var(--color-bg-2)]/50 border-y border-[color:var(--color-line)]">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32 grid gap-12 lg:grid-cols-12 items-center">
        <div class="lg:col-span-5">
          {block.image ? (
            <div class="arch-frame aspect-[4/5] max-w-sm mx-auto overflow-hidden">
              <img src={block.image} alt={block.name || ""} class="w-full h-full object-cover" />
            </div>
          ) : (
            <div class="arch-frame aspect-[4/5] max-w-sm mx-auto bg-gradient-to-br from-[color:var(--color-clay-soft)] via-[color:var(--color-butter)] to-[color:var(--color-bg-3)]" />
          )}
        </div>
        <div class="lg:col-span-7">
          {block.role && <span class="eyebrow">{block.role}</span>}
          {block.name && <h2 class="mt-4">{block.name}</h2>}
          {block.text && <p class="mt-6 text-lg text-[color:var(--color-ink-2)] max-w-xl leading-relaxed">{block.text}</p>}
          {block.cta_text && block.cta_href && (
            <a href={block.cta_href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] px-7 py-3 text-sm font-medium hover:bg-[color:var(--color-clay)] transition">
              {block.cta_text} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </section>
  );

  if (block.type === "columns") {
    const layout = block.layout || "text-image";
    const isImageRight = layout === "text-image";
    const isImageLeft = layout === "image-text";
    return (
      <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
        <div class="grid gap-10 lg:grid-cols-2 items-center">
          <div class={isImageLeft ? "order-2 lg:order-2" : ""}>
            {isImageLeft && block.left_content ? (
              <img src={block.left_content} alt="" class="w-full rounded-2xl" />
            ) : (
              <div class="prose" set:html={block.left_content || ""} />
            )}
          </div>
          <div class={isImageLeft ? "order-1 lg:order-1" : ""}>
            {isImageRight && block.right_content ? (
              <img src={block.right_content} alt="" class="w-full rounded-2xl" />
            ) : (
              <div class="prose" set:html={block.right_content || ""} />
            )}
          </div>
        </div>
      </section>
    );
  }

  if (block.type === "numberedcards") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string, i: number) => {
      const [title, text] = line.split("|").map((s: string) => s.trim());
      return { num: String(i + 1).padStart(2, "0"), title, text };
    });
    return (
      <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <div class="lg:sticky lg:top-28">
              {block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
              {block.title && <h2 class="mt-4">{block.title}</h2>}
              {block.subtitle && <p class="mt-6 text-[color:var(--color-mute)] max-w-sm">{block.subtitle}</p>}
            </div>
          </div>
          <div class="lg:col-span-8 grid gap-4">
            {items.map((p: any) => (
              <article class="group rounded-3xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur p-8 md:p-10 hover:border-[color:var(--color-ink)] transition">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-mono text-xs tracking-widest text-[color:var(--color-clay)]">{p.num}</span>
                  <span class="h-px flex-1 bg-[color:var(--color-line)]" />
                </div>
                <h3 class="mt-4 font-display">{p.title}</h3>
                {p.text && <p class="mt-3 text-[color:var(--color-mute)] leading-relaxed max-w-2xl">{p.text}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (block.type === "bento") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [label, title, text, href, style] = line.split("|").map((s: string) => s.trim());
      return { label, title, text, href: href || "#", style: style || "outline" };
    });
    return (
      <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-24 lg:pb-32">
        {(block.eyebrow || block.title) && (
          <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
            <div>
              {block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
              {block.title && <h2 class="mt-3">{block.title}</h2>}
            </div>
            {block.link_text && block.link_href && (
              <a href={block.link_href} class="text-sm underline underline-offset-4 decoration-[color:var(--color-clay)] hover:text-[color:var(--color-clay)]">{block.link_text} →</a>
            )}
          </div>
        )}
        <div class="grid gap-4 md:grid-cols-6 md:grid-rows-2">
          {items.map((item: any, i: number) => {
            if (item.style === "big" || i === 0) return (
              <a href={item.href} class="group relative md:col-span-4 md:row-span-2 rounded-3xl overflow-hidden p-8 md:p-12 bg-[color:var(--color-ink)] text-[color:var(--color-bg)] min-h-[340px] flex flex-col justify-between">
                <div>
                  {item.label && <span class="eyebrow" style="color:var(--color-clay-soft)">{item.label}</span>}
                  <h3 class="mt-4 font-display text-3xl md:text-5xl leading-[1.05] text-[color:var(--color-bg)]">{item.title}</h3>
                </div>
                <p class="text-[color:var(--color-bg-2)] max-w-md leading-relaxed">{item.text}</p>
              </a>
            );
            if (item.style === "butter") return (
              <a href={item.href} class="group md:col-span-2 rounded-3xl overflow-hidden p-8 bg-[color:var(--color-butter)] min-h-[180px] flex flex-col justify-between hover:bg-[color:var(--color-clay-soft)] transition">
                <div>
                  {item.label && <span class="eyebrow">{item.label}</span>}
                  <h3 class="mt-3 font-display text-xl md:text-2xl leading-[1.1]">{item.title}</h3>
                </div>
                {item.text && <p class="text-sm text-[color:var(--color-ink-2)] leading-relaxed mt-4">{item.text}</p>}
              </a>
            );
            return (
              <a href={item.href} class="group md:col-span-2 rounded-3xl overflow-hidden p-8 border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur min-h-[180px] flex flex-col justify-between hover:border-[color:var(--color-ink)] transition">
                <div>
                  {item.label && <span class="eyebrow">{item.label}</span>}
                  <h3 class="mt-3 font-display text-xl md:text-2xl leading-[1.1]">{item.title}</h3>
                </div>
                {item.text && <p class="text-sm text-[color:var(--color-mute)] leading-relaxed mt-4">{item.text}</p>}
              </a>
            );
          })}
        </div>
      </section>
    );
  }

  if (block.type === "posts") return (
    <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32" data-posts-block data-count={block.count || "3"} data-eyebrow={block.eyebrow || "Blog"} data-title={block.title || "Zuletzt geschrieben"} data-link-text={block.link_text || ""} data-link-href={block.link_href || ""}>
      <div class="flex items-end justify-between flex-wrap gap-4 mb-12">
        <div>
          <span class="eyebrow">{block.eyebrow || "Blog"}</span>
          <h2 class="mt-3">{block.title || "Zuletzt geschrieben"}</h2>
        </div>
        {block.link_text && block.link_href && (
          <a href={block.link_href} class="text-sm underline underline-offset-4 decoration-[color:var(--color-clay)] hover:text-[color:var(--color-clay)]">{block.link_text} →</a>
        )}
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <p class="text-[color:var(--color-mute)] col-span-full text-center py-8">Blog-Posts werden beim Seitenaufruf automatisch geladen.</p>
      </div>
    </section>
  );

  if (block.type === "video") {
    let embedUrl = "";
    const url = block.url || "";
    const ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
    const vmMatch = url.match(/vimeo\.com\/(\d+)/);
    if (ytMatch) embedUrl = `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
    else if (vmMatch) embedUrl = `https://player.vimeo.com/video/${vmMatch[1]}`;
    return (
      <section class="mx-auto max-w-4xl px-6 lg:px-10 py-16">
        {embedUrl ? (
          <div class="aspect-video rounded-2xl overflow-hidden bg-black">
            <iframe src={embedUrl} class="w-full h-full" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" />
          </div>
        ) : (
          <p class="text-[color:var(--color-mute)] text-center">Video-URL ungültig</p>
        )}
        {block.caption && <p class="mt-3 text-center text-sm text-[color:var(--color-mute)]">{block.caption}</p>}
      </section>
    );
  }

  if (block.type === "gallery") {
    const cols = Number(block.columns) || 3;
    const images = (block.images || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [url, alt, caption] = line.split("|").map((s: string) => s.trim());
      return { url, alt: alt || "", caption };
    });
    const gridClass = "grid gap-4 grid-cols-2" + (cols >= 3 ? " md:grid-cols-3" : "") + (cols >= 4 ? " lg:grid-cols-4" : "");
    return (
      <section class="mx-auto max-w-6xl px-6 lg:px-10 py-16">
        <div class={gridClass}>
          {images.map((img: any) => (
            <figure class="group">
              <div class="aspect-square rounded-2xl overflow-hidden bg-[color:var(--color-bg-2)]">
                <img src={img.url} alt={img.alt} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              </div>
              {img.caption && <figcaption class="mt-2 text-xs text-[color:var(--color-mute)] text-center">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    );
  }

  if (block.type === "divider") {
    const sz = block.size || "md";
    const st = block.style || "line";
    const py = sz === "sm" ? "py-4" : sz === "lg" ? "py-16" : "py-8";
    return (
      <div class={`mx-auto max-w-5xl px-6 lg:px-10 ${py}`}>
        {st === "line" && <hr class="border-[color:var(--color-line)]" />}
        {st === "dots" && <div class="text-center text-[color:var(--color-clay)] tracking-[.5em]">···</div>}
      </div>
    );
  }

  if (block.type === "accordion") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [question, answer] = line.split("|").map((s: string) => s.trim());
      return { question, answer };
    });
    return (
      <section class="mx-auto max-w-3xl px-6 lg:px-10 py-16">
        {block.title && <h2 class="mb-8 text-center">{block.title}</h2>}
        <div class="space-y-3">
          {items.map((item: any) => (
            <details class="group rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70 backdrop-blur">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display text-sm font-medium list-none">
                {item.question}
                <span class="shrink-0 text-[color:var(--color-clay)] transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="px-6 pb-5 text-sm text-[color:var(--color-mute)] leading-relaxed">{item.answer}</div>
            </details>
          ))}
        </div>
      </section>
    );
  }

  if (block.type === "stats") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [num, label] = line.split("|").map((s: string) => s.trim());
      return { num, label };
    });
    return (
      <section class="mx-auto max-w-5xl px-6 lg:px-10 py-16">
        {block.eyebrow && <span class="eyebrow text-center block mb-8">{block.eyebrow}</span>}
        <div class:list={["grid gap-8 text-center grid-cols-2", items.length >= 3 && "md:grid-cols-3", items.length >= 4 && "lg:grid-cols-4"]}>
          {items.map((item: any) => (
            <div>
              <div class="font-display text-4xl md:text-5xl text-[color:var(--color-clay)]">{item.num}</div>
              <div class="mt-2 text-sm text-[color:var(--color-mute)]">{item.label}</div>
            </div>
          ))}
        </div>
      </section>
    );
  }

  if (block.type === "pricing") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [name, price, features, cta_text, cta_href] = line.split("|").map((s: string) => s.trim());
      return { name, price, features: (features || "").split(";").map((f: string) => f.trim()).filter(Boolean), cta_text, cta_href };
    });
    return (
      <section class="mx-auto max-w-5xl px-6 lg:px-10 py-16">
        {block.eyebrow && <span class="eyebrow text-center block">{block.eyebrow}</span>}
        {block.title && <h2 class="mt-4 mb-12 text-center">{block.title}</h2>}
        <div class:list={["grid gap-6", items.length >= 3 ? "md:grid-cols-3" : items.length === 2 ? "md:grid-cols-2" : ""]}>
          {items.map((item: any, i: number) => (
            <div class:list={[
              "rounded-3xl p-8 text-center",
              i === 0 ? "bg-[color:var(--color-ink)] text-[color:var(--color-bg)]" : "border border-[color:var(--color-line)] bg-[color:var(--color-bg)]/70"
            ]}>
              <h3 class="font-display text-lg">{item.name}</h3>
              <div class:list={["mt-4 font-display text-3xl", i === 0 ? "text-[color:var(--color-clay)]" : "text-[color:var(--color-clay)]"]}>{item.price}</div>
              {item.features.length > 0 && (
                <ul class="mt-6 space-y-2 text-sm text-left">
                  {item.features.map((f: string) => (
                    <li class:list={["flex items-start gap-2", i === 0 ? "text-[color:var(--color-bg-2)]" : "text-[color:var(--color-mute)]"]}>
                      <span class="text-[color:var(--color-clay)] mt-0.5">✓</span> {f}
                    </li>
                  ))}
                </ul>
              )}
              {item.cta_text && (
                <a href={item.cta_href || "#"} class:list={[
                  "mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium transition",
                  i === 0 ? "bg-[color:var(--color-clay)] text-[color:var(--color-bg)]" : "bg-[color:var(--color-ink)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-clay)]"
                ]}>
                  {item.cta_text} →
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    );
  }

  if (block.type === "quote") return (
    <section class="mx-auto max-w-3xl px-6 lg:px-10 py-20 text-center">
      <div class="text-[color:var(--color-clay)] text-5xl font-display leading-none mb-6">„</div>
      {block.text && <blockquote class="font-display text-2xl md:text-3xl leading-snug text-[color:var(--color-ink)]">{block.text}</blockquote>}
      {block.author && (
        <div class="mt-8 text-sm text-[color:var(--color-mute)]">
          — {block.author}{block.role ? `, ${block.role}` : ""}
        </div>
      )}
    </section>
  );

  if (block.type === "list") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim());
    const icon = block.style === "arrow" ? "→" : block.style === "dot" ? "•" : "✓";
    return (
      <section class="mx-auto max-w-3xl px-6 lg:px-10 py-16">
        {block.title && <h2 class="mb-8">{block.title}</h2>}
        <ul class="space-y-3">
          {items.map((item: string) => (
            <li class="flex items-start gap-3 text-[color:var(--color-ink-2)]">
              <span class="mt-1 text-[color:var(--color-clay)] shrink-0">{icon}</span>
              <span>{item.trim()}</span>
            </li>
          ))}
        </ul>
      </section>
    );
  }

  if (block.type === "callout") {
    const st = block.style || "info";
    const bgMap = { info: "bg-blue-50", warning: "bg-amber-50", tip: "bg-emerald-50" } as any;
    const borderMap = { info: "border-blue-200", warning: "border-amber-200", tip: "border-emerald-200" } as any;
    const iconMap = { info: "ℹ️", warning: "⚠️", tip: "💡" } as any;
    return (
      <section class="mx-auto max-w-3xl px-6 lg:px-10 py-8">
        <div class:list={[bgMap[st] || "bg-blue-50", borderMap[st] || "border-blue-200", "border rounded-2xl p-6 flex gap-4 items-start"]}>
          <span class="text-xl shrink-0">{iconMap[st] || "ℹ️"}</span>
          <div>
            {block.title && <h3 class="font-display text-base mb-1">{block.title}</h3>}
            {block.text && <p class="text-sm text-[color:var(--color-ink-2)] leading-relaxed">{block.text}</p>}
          </div>
        </div>
      </section>
    );
  }

  if (block.type === "timeline") {
    const items = (block.items || "").split("\n").filter((l: string) => l.trim()).map((line: string) => {
      const [title, text] = line.split("|").map((s: string) => s.trim());
      return { title, text };
    });
    return (
      <section class="mx-auto max-w-3xl px-6 lg:px-10 py-16">
        {block.title && <h2 class="mb-10 text-center">{block.title}</h2>}
        <div class="relative pl-8 border-l-2 border-[color:var(--color-line)] space-y-10">
          {items.map((item: any, i: number) => (
            <div class="relative">
              <span class="absolute -left-[calc(2rem+5px)] w-3 h-3 rounded-full bg-[color:var(--color-clay)] border-2 border-[color:var(--color-bg)]" />
              <h3 class="font-display text-base">{item.title}</h3>
              {item.text && <p class="mt-2 text-sm text-[color:var(--color-mute)] leading-relaxed">{item.text}</p>}
            </div>
          ))}
        </div>
      </section>
    );
  }

  return null;
})}
