# Seelenmut reverse proxy
# --------------------------------------------------------
# Caddy handles automatic HTTPS via Let's Encrypt.
# Before going live on a VPS:
#   1. Point seelenmut.net and admin.seelenmut.net at the server IP
#   2. Replace ADMIN_EMAIL below with your address
#   3. docker compose up -d
#
# For local testing you can swap the site blocks for
#   http://localhost
# and skip TLS entirely.

{
	email ADMIN_EMAIL
}

# ---- Public website ----
seelenmut.net, www.seelenmut.net {
	encode zstd gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# User-uploaded images live in the CMS container's /media volume
	handle_path /media/* {
		reverse_proxy cms:8000
	}

	# Everything else is the Astro SSR server
	reverse_proxy frontend:4321
}

# ---- CMS admin on a separate subdomain ----
admin.seelenmut.net {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	reverse_proxy cms:8000
}
