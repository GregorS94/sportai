# CMS Admin credentials (change both values!)
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=change-me-please

# Random secret for signing session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CMS_SECRET_KEY=replace-with-a-long-random-string

# Storage locations (optional – defaults are relative to the app folder)
CMS_DB=/app/data/cms.db
CMS_MEDIA_DIR=/app/data/media

# CORS: comma-separated list of allowed frontend origins.
# Use * for any origin during development.
CMS_CORS_ORIGINS=*
