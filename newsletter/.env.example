# Newsletter Mailing - Environment variables
# Diese Werte sind optional und überschreiben die in der UI gespeicherten Einstellungen.
#
# all-inkl.com SMTP-Einstellungen:
# - Host: smtp.kasserver.com (oder der dir zugewiesene w01XXXXX.kasserver.com)
# - Port: 465 (SSL) oder 587 (STARTTLS)
# - Benutzer: die Adresse deines E-Mail-Postfachs
# - Passwort: das Passwort des E-Mail-Postfachs (nicht der KAS-Login!)

NEWSLETTER_SMTP_HOST=smtp.kasserver.com
NEWSLETTER_SMTP_PORT=465
NEWSLETTER_SMTP_SECURITY=ssl
NEWSLETTER_SMTP_USER=postfach@deine-domain.de
NEWSLETTER_SMTP_PASSWORD=geheim
NEWSLETTER_FROM_EMAIL=postfach@deine-domain.de
NEWSLETTER_FROM_NAME=Dein Absendername

# Pfad zur SQLite-Datenbank (optional)
NEWSLETTER_DB=/app/data/newsletter.db
